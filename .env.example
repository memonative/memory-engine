# ──────────────────────────────────────────────────────────────────────
# Memonative — Environment Configuration
# Copy to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────

# ── Database (required) ─────────────────────────────────────────────
# Must use the asyncpg driver prefix. For a managed host: add ?ssl=require
DATABASE_URL=postgresql+asyncpg://memonative:memonative@localhost:5432/memonative

# ── Redis (required) ────────────────────────────────────────────────
# Celery broker + beat lock backend. For Upstash: use rediss:// with
# ?ssl_cert_reqs=CERT_NONE
REDIS_URL=redis://localhost:6379/0

# ── LLM keys ────────────────────────────────────────────────────────
# Embeddings — text-embedding-3-small, 1536 dims. The pgvector indexes
# are dimension-locked to this model; changing it means reindexing.
OPENAI_API_KEY=sk-...

# Engine LLM — every structured-JSON task (extraction, consensus,
# reconsolidation). Any OpenAI-compatible endpoint works; point
# DEEPSEEK_BASE_URL at it.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Auth ────────────────────────────────────────────────────────────
# Master bearer token for /v1/* and /admin/*. Leave empty for dev mode,
# which disables auth entirely — never do that on a reachable host.
API_KEY=

# ── Per-tenant keys (optional) ──────────────────────────────────────
# Set this to let tenants override the engine key above with their own,
# stored encrypted at rest and managed via PUT /admin/tenants/{id}/credentials.
# Leave empty to run every tenant on the shared key above.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# ── Cross-encoder reranking (optional) ─────────────────────────────
# Neural reranker that reorders retrieved memories by relevance.
# Enabled by default. Two backends:
#
# Local (default) — runs a small model on the server (~80MB).
#   Requires: pip install sentence-transformers
#   No extra env vars needed.
#
# API — hosted reranker (Jina or Cohere). No local model needed.
#   RERANK_BACKEND=api
#   RERANK_API_PROVIDER=jina          # or "cohere"
#   RERANK_API_KEY=jnv_your_key_here
#
# To disable reranking entirely:
#   RERANK_ENABLED=false
